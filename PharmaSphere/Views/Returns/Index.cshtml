@model PharmaSphere.Web.ViewModels.ReturnIndexViewModel

@{
    ViewData["Title"] = "إدارة المرتجعات";
}

<div class="container-fluid py-4" dir="rtl">

    <!-- Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-arrow-return-left text-primary"></i>
                إدارة المرتجعات
            </h2>

            <p class="text-muted mb-0">
                إدارة مرتجعات المبيعات وإعادة المنتجات إلى المخزون
            </p>
        </div>

        <a asp-controller="Returns"
           asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-lg"></i>
            تسجيل مرتجع

        </a>

    </div>


    <!-- Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="bi bi-exclamation-triangle me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Statistics -->

    <div class="row g-4 mb-4">

        <div class="col-md-4">

            <div class="card border-0 shadow-sm stat-card">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <p class="text-muted mb-1">
                                إجمالي المرتجعات
                            </p>

                            <h3 class="fw-bold">
                                @Model.TotalReturns
                            </h3>
                        </div>

                        <div class="icon-box">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm stat-card">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                إجمالي المبالغ المستردة
                            </p>

                            <h3 class="fw-bold text-danger">

                                @Model.TotalRefunds.ToString("N2")

                                <small>ج.م</small>

                            </h3>

                        </div>

                        <div class="icon-box danger">

                            <i class="bi bi-cash-stack"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm stat-card">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                متوسط قيمة المرتجع
                            </p>

                            <h3 class="fw-bold">

                                @(Model.TotalReturns > 0
                                    ? (Model.TotalRefunds / Model.TotalReturns).ToString("N2")
                                    : "0.00")

                                <small>ج.م</small>

                            </h3>

                        </div>

                        <div class="icon-box warning">

                            <i class="bi bi-calculator"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Table -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <h5 class="fw-bold mb-0">
                سجل المرتجعات
            </h5>

        </div>

        <div class="card-body p-0">

            @if (Model.Returns.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>#</th>

                                <th>رقم الطلب</th>

                                <th>الدواء</th>

                                <th>رقم التشغيلة</th>

                                <th>الكمية</th>

                                <th>المبلغ المسترد</th>

                                <th>السبب</th>

                                <th>تاريخ المرتجع</th>

                                <th></th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model.Returns)
                            {
                                <tr>

                                    <td>
                                        <span class="badge bg-light text-dark">
                                            #@item.Id
                                        </span>
                                    </td>

                                    <td>
                                        <strong>
                                            @item.OrderNumber
                                        </strong>
                                    </td>

                                    <td>
                                        @item.MedicineName
                                    </td>

                                    <td>
                                        <code>
                                            @item.BatchNumber
                                        </code>
                                    </td>

                                    <td>
                                        @item.ReturnedUnits
                                    </td>

                                    <td class="text-danger fw-bold">

                                        @item.RefundAmount.ToString("N2")
                                        ج.م

                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.Reason)
                                            ? "—"
                                            : item.Reason)
                                    </td>
                                    <td>
                                        @(item.ReturnedAt.ToString("dd/MM/yyyy HH:mm"))
                                    </td>


                                    <td>

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-arrow-return-left display-4 text-muted"></i>

                    <h5 class="mt-3">
                        لا توجد مرتجعات
                    </h5>

                    <p class="text-muted">
                        لم يتم تسجيل أي مرتجعات حتى الآن.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">

                        تسجيل أول مرتجع

                    </a>

                </div>
            }

        </div>

    </div>

</div>


<style>

    .stat-card {
        transition: all .2s ease;
    }

        .stat-card:hover {
            transform: translateY(-3px);
        }

    .icon-box {
        width: 52px;
        height: 52px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        background: #e8f1ff;
        color: #2563eb;
    }

        .icon-box.danger {
            background: #fee2e2;
            color: #dc2626;
        }

        .icon-box.warning {
            background: #fef3c7;
            color: #d97706;
        }

    table th {
        white-space: nowrap;
    }

</style>