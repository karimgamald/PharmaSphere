@using PharmaSphere.Domain.Enums
@model PharmaSphere.Domain.Entities.Order

@{
    ViewData["Title"] = "تحديث حالة الطلب";
}

<div dir="rtl" class="container-fluid py-4">

    ```
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-arrow-repeat text-primary me-2"></i>
                تحديث حالة الطلب
            </h2>

            <p class="text-muted mb-0">
                تغيير الحالة الحالية للطلب
            </p>
        </div>

        <a asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-right me-1"></i>
            العودة للطلب

        </a>

    </div>


    <div class="row g-4">

        <!-- Order Information -->
        <div class="col-lg-5">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-receipt me-2"></i>
                        معلومات الطلب
                    </h5>

                </div>

                <div class="card-body px-4">

                    <div class="mb-4">

                        <small class="text-muted d-block mb-1">
                            رقم الطلب
                        </small>

                        <h5 class="fw-bold mb-0">
                            #@Model.OrderNumber
                        </h5>

                    </div>


                    <div class="mb-4">

                        <small class="text-muted d-block mb-1">
                            تاريخ الطلب
                        </small>

                        <span>
                            @Model.OrderDate.ToLocalTime()
                            .ToString("dd/MM/yyyy hh:mm tt")
                        </span>

                    </div>


                    <div class="mb-4">

                        <small class="text-muted d-block mb-1">
                            الحالة الحالية
                        </small>

                        @switch (Model.OrderStatus)
                        {
                            case OrderStatus.Pending:
                                <span class="badge bg-warning text-dark">
                                    <i class="bi bi-hourglass-split me-1"></i>
                                    قيد الانتظار
                                </span>
                                break;

                            case OrderStatus.Preparing:
                                <span class="badge bg-info">
                                    <i class="bi bi-gear me-1"></i>
                                    قيد التجهيز
                                </span>
                                break;

                            case OrderStatus.OutForDelivery:
                                <span class="badge bg-primary">
                                    <i class="bi bi-truck me-1"></i>
                                    تم الشحن
                                </span>
                                break;

                            case OrderStatus.Completed:
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle me-1"></i>
                                    مكتمل
                                </span>
                                break;

                            case OrderStatus.Cancelled:
                                <span class="badge bg-danger">
                                    <i class="bi bi-x-circle me-1"></i>
                                    ملغي
                                </span>
                                break;

                            default:
                                <span class="badge bg-secondary">
                                    @Model.OrderStatus
                                </span>
                                break;
                        }

                    </div>


                    <div class="mb-4">

                        <small class="text-muted d-block mb-1">
                            حالة الدفع
                        </small>

                        <span class="badge bg-light text-dark border">
                            @Model.PaymentStatus
                        </span>

                    </div>


                    <hr />


                    <div class="d-flex justify-content-between align-items-center">

                        <span class="text-muted">
                            إجمالي الطلب
                        </span>

                        <strong class="fs-5 text-primary">
                            @Model.TotalAmount.ToString("N2") جنيه
                        </strong>

                    </div>

                </div>

            </div>

        </div>


        <!-- Update Status -->
        <div class="col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <h5 class="fw-bold mb-1">
                        <i class="bi bi-pencil-square me-2"></i>
                        تغيير حالة الطلب
                    </h5>

                    <p class="text-muted small mb-0">
                        اختر الحالة الجديدة ثم اضغط على حفظ
                    </p>

                </div>


                <div class="card-body p-4">

                    <form asp-action="UpdateStatus"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="orderId"
                               value="@Model.Id" />


                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                الحالة الجديدة
                            </label>

                            <select name="status"
                                    class="form-select form-select-lg"
                                    required>

                                <option value="">
                                    -- اختر حالة الطلب --
                                </option>

                                @if (Model.OrderStatus == OrderStatus.Pending)
                                {
                                    <option value="@OrderStatus.Pending">
                                        قيد الانتظار
                                    </option>
                                }

                                <option value="@OrderStatus.Preparing">
                                    قيد التجهيز
                                </option>

                                <option value="@OrderStatus.OutForDelivery">
                                    تم الشحن
                                </option>

                                <option value="@OrderStatus.Completed">
                                    مكتمل
                                </option>

                                @if (Model.OrderStatus == OrderStatus.Pending)
                                {
                                    <option value="@OrderStatus.Cancelled">
                                        ملغي
                                    </option>
                                }

                            </select>

                        </div>


                        <!-- Status Flow -->
                        <div class="bg-light rounded-3 p-4 mb-4">

                            <h6 class="fw-bold mb-3">
                                <i class="bi bi-diagram-3 me-2"></i>
                                مسار الطلب
                            </h6>

                            <div class="d-flex flex-wrap align-items-center gap-2">

                                <span class="badge bg-warning text-dark p-2">
                                    Pending
                                </span>

                                <i class="bi bi-arrow-left text-muted"></i>

                                <span class="badge bg-info p-2">
                                    Processing
                                </span>

                                <i class="bi bi-arrow-left text-muted"></i>

                                <span class="badge bg-primary p-2">
                                    Shipped
                                </span>

                                <i class="bi bi-arrow-left text-muted"></i>

                                <span class="badge bg-success p-2">
                                    Completed
                                </span>

                            </div>

                            <small class="text-muted d-block mt-3">
                                يمكن إلغاء الطلب أثناء حالة Pending فقط.
                            </small>

                        </div>


                        <!-- Warning -->
                        <div class="alert alert-info border-0">

                            <i class="bi bi-info-circle-fill me-2"></i>

                            عند تغيير الحالة إلى
                            <strong>Completed</strong>
                            تأكد من أن الطلب تم تسليمه فعلياً للعميل.

                        </div>


                        <!-- Buttons -->
                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Details"
                               asp-route-id="@Model.Id"
                               class="btn btn-light border px-4">

                                <i class="bi bi-x-lg me-1"></i>
                                إلغاء

                            </a>


                            <button type="submit"
                                    class="btn btn-primary px-4">

                                <i class="bi bi-check-lg me-1"></i>
                                حفظ الحالة

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>
    ```

</div>
