@model PharmaSphere.Web.ViewModels.ProfitReportViewModel

@{
    ViewData["Title"] = "تقرير الأرباح";
}

<div class="container-fluid py-4" dir="rtl">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-graph-up-arrow text-primary"></i>
                تقرير الأرباح
            </h2>

            <p class="text-muted mb-0">
                تحليل المبيعات والتكاليف والأرباح خلال الفترة المحددة
            </p>
        </div>

        <button class="btn btn-outline-primary"
                onclick="window.print()">

            <i class="bi bi-printer"></i>
            طباعة التقرير
        </button>

    </div>


    <!-- Date Filter -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form method="get"
                  asp-controller="Reports"
                  asp-action="ProfitReport"
                  class="row g-3 align-items-end">

                <div class="col-md-4">

                    <label class="form-label fw-semibold">
                        من تاريخ
                    </label>

                    <input type="date"
                           name="fromDate"
                           value="@Model.FromDate.ToString("yyyy-MM-dd")"
                           class="form-control" />

                </div>

                <div class="col-md-4">

                    <label class="form-label fw-semibold">
                        إلى تاريخ
                    </label>

                    <input type="date"
                           name="toDate"
                           value="@Model.ToDate.ToString("yyyy-MM-dd")"
                           class="form-control" />

                </div>

                <div class="col-md-4">

                    <button type="submit"
                            class="btn btn-primary w-100">

                        <i class="bi bi-search"></i>
                        عرض التقرير

                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- Statistics -->
    <div class="row g-4 mb-4">

        <!-- Sales -->
        <div class="col-xl-3 col-md-6">

            <div class="card stat-card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <p class="text-muted mb-1">
                                إجمالي المبيعات
                            </p>

                            <h3 class="fw-bold">
                                @Model.TotalSales.ToString("N2")
                                <small>ج.م</small>
                            </h3>
                        </div>

                        <div class="icon-box sales">
                            <i class="bi bi-cart-check"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Cost -->
        <div class="col-xl-3 col-md-6">

            <div class="card stat-card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                تكلفة البضاعة
                            </p>

                            <h3 class="fw-bold">
                                @Model.TotalCost.ToString("N2")
                                <small>ج.م</small>
                            </h3>

                        </div>

                        <div class="icon-box cost">
                            <i class="bi bi-box-seam"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Profit -->
        <div class="col-xl-3 col-md-6">

            <div class="card stat-card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                صافي الربح
                            </p>

                            <h3 class="fw-bold text-success">

                                @Model.TotalProfit.ToString("N2")
                                <small>ج.م</small>

                            </h3>

                        </div>

                        <div class="icon-box profit">

                            <i class="bi bi-currency-dollar"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Orders -->
        <div class="col-xl-3 col-md-6">

            <div class="card stat-card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                عدد الطلبات
                            </p>

                            <h3 class="fw-bold">
                                @Model.TotalOrders
                            </h3>

                            <small class="text-muted">
                                متوسط الطلب:
                                @Model.AverageOrderValue.ToString("N2")
                                ج.م
                            </small>

                        </div>

                        <div class="icon-box orders">

                            <i class="bi bi-receipt"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Profit Margin -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between mb-2">

                <span class="fw-semibold">
                    هامش الربح
                </span>

                <span class="fw-bold text-primary">
                    @Model.ProfitMargin.ToString("N2")%
                </span>

            </div>

            <div class="progress"
                 style="height: 12px;">

                <div class="progress-bar bg-success"
                     role="progressbar"
                     style="width: @Math.Min(Model.ProfitMargin, 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                </div>

            </div>

        </div>

    </div>


    <!-- Report Table -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">
                        تفاصيل المبيعات
                    </h5>

                    <small class="text-muted">

                        من
                        @Model.FromDate.ToString("dd/MM/yyyy")
                        إلى
                        @Model.ToDate.ToString("dd/MM/yyyy")

                    </small>

                </div>

                <span class="badge bg-primary">

                    @Model.Items.Count عملية

                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.Items.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>رقم الطلب</th>

                                <th>التاريخ</th>

                                <th>الدواء</th>

                                <th>الكمية</th>

                                <th>سعر البيع</th>

                                <th>التكلفة</th>

                                <th>المبيعات</th>

                                <th>التكلفة الإجمالية</th>

                                <th>الربح</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model.Items)
                            {
                                <tr>

                                    <td>
                                        <span class="fw-semibold">
                                            @item.OrderNumber
                                        </span>
                                    </td>

                                    <td>
                                        @item.OrderDate.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        @item.MedicineName
                                    </td>

                                    <td>
                                        @item.Quantity
                                    </td>

                                    <td>
                                        @item.SellingPrice.ToString("N2")
                                        ج.م
                                    </td>

                                    <td>
                                        @item.CostPrice.ToString("N2")
                                        ج.م
                                    </td>

                                    <td>
                                        @item.SalesAmount.ToString("N2")
                                        ج.م
                                    </td>

                                    <td>
                                        @item.CostAmount.ToString("N2")
                                        ج.م
                                    </td>

                                    <td>

                                        @if (item.Profit >= 0)
                                        {
                                            <span class="text-success fw-bold">
                                                +@item.Profit.ToString("N2")
                                                ج.م
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-danger fw-bold">
                                                @item.Profit.ToString("N2")
                                                ج.م
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                        <tfoot class="table-light">

                            <tr>

                                <th colspan="6"
                                    class="text-end">

                                    الإجمالي

                                </th>

                                <th>

                                    @Model.TotalSales.ToString("N2")
                                    ج.م

                                </th>

                                <th>

                                    @Model.TotalCost.ToString("N2")
                                    ج.م

                                </th>

                                <th class="text-success">

                                    @Model.TotalProfit.ToString("N2")
                                    ج.م

                                </th>

                            </tr>

                        </tfoot>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-bar-chart-line display-4 text-muted"></i>

                    <h5 class="mt-3">
                        لا توجد بيانات
                    </h5>

                    <p class="text-muted">
                        لا توجد مبيعات مكتملة خلال الفترة المحددة.
                    </p>

                </div>
            }

        </div>

    </div>

</div>


<style>

    .stat-card {
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.10) !important;
        }

    .icon-box {
        width: 52px;
        height: 52px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

        .icon-box.sales {
            background: #e8f1ff;
            color: #2563eb;
        }

        .icon-box.cost {
            background: #fff4e5;
            color: #f59e0b;
        }

        .icon-box.profit {
            background: #e9f8ef;
            color: #16a34a;
        }

        .icon-box.orders {
            background: #f3e8ff;
            color: #9333ea;
        }

    .table th {
        white-space: nowrap;
    }

    @@media print {

        .btn,
        form,
        nav,
        footer {
            display: none !important;
        }

        .card {
            box-shadow: none !important;
            border: 1px solid #ddd !important;
        }

        body {
            background: white !important;
        }
    }

</style>