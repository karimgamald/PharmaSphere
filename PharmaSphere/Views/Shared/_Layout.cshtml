                                   id="systemDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    <i class="bi bi-gear-wide-connected"></i>

                                    <span>النظام والمراقبة</span>

                                </a>


                                <ul class="dropdown-menu dropdown-menu-end ps-dropdown">

                                    <li class="ps-dropdown-title">
                                        النظام
