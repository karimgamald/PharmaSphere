@using Microsoft.AspNetCore.Identity
@using PharmaSphere.Domain.Entities

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>

<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - PharmaSphere
    </title>

    <!-- =====================================================
     Google Font
====================================================== -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap"
          rel="stylesheet" />

    <!-- =====================================================
     Bootstrap 5 RTL
====================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" />

    <!-- =====================================================
     Bootstrap Icons
====================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- =====================================================
     PharmaSphere Global Styles
====================================================== -->

    <style>

            :root {
                --ps-primary: #0d6efd;
                --ps-primary-dark: #0756c9;
                --ps-dark: #0f172a;
                --ps-dark-light: #172033;
                --ps-body-bg: #f5f7fb;
                --ps-border: #e5eaf1;
                --ps-text: #172033;
                --ps-muted: #7c8797;
                --ps-white: #ffffff;
                --ps-font: 'Cairo', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            }

            /* =====================================================
                   GLOBAL
                ====================================================== */

            html {
                font-size: 15px;
            }

            body {
                min-height: 100vh;
                margin: 0;
                font-family: var(--ps-font);
                background-color: var(--ps-body-bg);
                color: var(--ps-text);
                letter-spacing: -0.15px;
                -webkit-font-smoothing: antialiased;
            }

            a {
                text-decoration: none;
            }

            /* =====================================================
                   NAVBAR
                ====================================================== */

            .ps-navbar {
                min-height: 70px;
                background: linear-gradient(135deg, #0f172a, #111c32);
                border-bottom: 1px solid rgba(255,255,255,.06);
                box-shadow: 0 4px 20px rgba(15,23,42,.12);
                backdrop-filter: blur(12px);
            }

            .ps-navbar-container {
                padding-left: 1.5rem;
                padding-right: 1.5rem;
            }

            /* =====================================================
                   BRAND
                ====================================================== */

            .ps-brand {
                display: inline-flex;
                align-items: center;
                gap: .7rem;
                color: white !important;
                font-weight: 800;
                letter-spacing: -.5px;
            }

            .ps-brand-icon {
                width: 40px;
                height: 40px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 12px;
                background: linear-gradient(135deg, #0d6efd, #0756c9);
                color: white;
                box-shadow: 0 6px 18px rgba(13,110,253,.25);
                font-size: 1.2rem;
            }

            .ps-brand-name {
                font-size: 1.25rem;
                font-weight: 900;
                line-height: 1;
            }

                .ps-brand-name span {
                    color: #4d9aff;
                }

            /* =====================================================
                   NAVIGATION
                ====================================================== */

            .ps-nav {
                gap: .2rem;
            }

            .ps-nav-link {
                position: relative;
                display: flex;
                align-items: center;
                gap: .35rem;
                padding: .55rem .75rem !important;
                border-radius: 9px;
                color: rgba(255,255,255,.62) !important;
                font-size: .78rem;
                font-weight: 700;
                transition: color .2s ease, background .2s ease;
            }

                .ps-nav-link:hover {
                    color: white !important;
                    background: rgba(255,255,255,.07);
                }

                .ps-nav-link.active {
                    color: white !important;
                    background: rgba(13,110,253,.16);
                }

                    .ps-nav-link.active::after {
                        content: "";
                        position: absolute;
                        bottom: -1px;
                        right: 12px;
                        left: 12px;
                        height: 2px;
                        border-radius: 5px;
                        background: var(--ps-primary);
                    }

                .ps-nav-link i {
                    font-size: .9rem;
                }

            /* =====================================================
                   DROPDOWN
                ====================================================== */

            .ps-dropdown {
                min-width: 230px;
                margin-top: .65rem !important;
                padding: .5rem;
                border: 1px solid var(--ps-border);
                border-radius: 14px;
                background: white;
                box-shadow: 0 18px 45px rgba(15,23,42,.14);
            }

            .ps-dropdown-item {
                display: flex;
                align-items: center;
                gap: .65rem;
                padding: .65rem .75rem;
                border-radius: 9px;
                color: #334155;
                font-size: .78rem;
                font-weight: 700;
                transition: background .2s ease, color .2s ease, transform .2s ease;
            }

                .ps-dropdown-item:hover {
                    color: var(--ps-primary);
                    background: #f4f7fb;
                    transform: translateX(-2px);
                }

                .ps-dropdown-item i {
                    width: 20px;
                    text-align: center;
                    font-size: .95rem;
                }

            .ps-dropdown-title {
                padding: .45rem .75rem .3rem;
                color: #98a1af;
                font-size: .62rem;
                font-weight: 900;
                letter-spacing: .8px;
            }

            /* =====================================================
                   SERVER STATUS
                ====================================================== */

            .ps-server-status {
                display: inline-flex;
                align-items: center;
                gap: .45rem;
                padding: .45rem .7rem;
                border: 1px solid rgba(32,201,151,.18);
                border-radius: 50px;
                background: rgba(32,201,151,.08);
                color: #65e0b6;
                font-size: .65rem;
                font-weight: 800;
            }

            .ps-server-dot {
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: #20c997;
                box-shadow: 0 0 0 4px rgba(32,201,151,.12);
            }

            /* =====================================================
                   USER AREA
                ====================================================== */

            .ps-user-area {
                display: flex;
                align-items: center;
                gap: .6rem;
                margin-right: .75rem;
            }

            .ps-user-info {
                display: flex;
                flex-direction: column;
                line-height: 1.2;
            }

            .ps-user-name {
                color: white;
                font-size: .75rem;
                font-weight: 800;
            }

            .ps-user-role {
                color: rgba(255,255,255,.45);
                font-size: .6rem;
                font-weight: 600;
            }

            .ps-user-icon {
                width: 38px;
                height: 38px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                background: rgba(13,110,253,.2);
                color: #75adff;
                font-size: 1rem;
            }

            .ps-login-btn {
                border-radius: 9px;
                font-size: .72rem;
                font-weight: 800;
                padding: .5rem .8rem;
            }

            .ps-logout-btn {
                border-radius: 9px;
                font-size: .7rem;
                font-weight: 700;
            }

            /* =====================================================
                   TOGGLER
                ====================================================== */

            .ps-toggler {
                border: 0 !important;
                padding: .4rem;
                box-shadow: none !important;
            }

            /* =====================================================
                   MAIN CONTENT
                ====================================================== */

            .ps-main {
                width: 100%;
                padding: 1.5rem 1.5rem 2.5rem;
            }

            /* =====================================================
                   FOOTER
                ====================================================== */

            .ps-footer {
                background: white;
                border-top: 1px solid var(--ps-border);
                color: #8a94a5;
                font-size: .68rem;
            }

                .ps-footer strong {
                    color: #1e293b;
                }

            .ps-footer-security {
                display: inline-flex;
                align-items: center;
                gap: .35rem;
                color: #667085;
            }

                .ps-footer-security i {
                    color: var(--ps-primary);
                }

            /* =====================================================
                   SCROLLBAR
                ====================================================== */

            ::-webkit-scrollbar {
                width: 7px;
                height: 7px;
            }

            ::-webkit-scrollbar-track {
                background: #f1f4f8;
            }

            ::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 10px;
            }

                ::-webkit-scrollbar-thumb:hover {
                    background: #94a3b8;
                }

            /* =====================================================
                   RESPONSIVE
                ====================================================== */

            @@media (max-width: 1199px) {

                .ps-nav-link {
                    padding-left: .55rem !important;
                    padding-right: .55rem !important;
                }

                    .ps-nav-link span {
                        display: none;
                    }

                    .ps-nav-link i {
                        margin: 0 !important;
                    }
            }

            @@media (max-width: 991px) {

                .ps-navbar-container {
                    padding-left: 1rem;
                    padding-right: 1rem;
                }

                .ps-nav {
                    padding-top: 1rem;
                    gap: .25rem;
                }

                .ps-nav-link {
                    justify-content: flex-start;
                    padding: .7rem .85rem !important;
                }

                    .ps-nav-link span {
                        display: inline;
                    }

                    .ps-nav-link.active::after {
                        display: none;
                    }

                .ps-dropdown {
                    margin-top: .25rem !important;
                    border: 0;
                    box-shadow: none;
                    background: #111c32;
                }

                .ps-dropdown-item {
                    color: rgba(255,255,255,.65);
                }

                    .ps-dropdown-item:hover {
                        color: white;
                        background: rgba(255,255,255,.07);
                    }

                .ps-dropdown-title {
                    color: rgba(255,255,255,.35);
                }

                .ps-server-status {
                    margin: .75rem 0 1rem;
                }

                .ps-user-area {
                    margin: .75rem 0;
                    padding: .5rem 0;
                }

                .ps-main {
                    padding: 1rem 1rem 2rem;
                }
            }

            @@media (max-width: 576px) {

                .ps-brand-name {
                    font-size: 1.05rem;
                }

                .ps-brand-icon {
                    width: 36px;
                    height: 36px;
                    border-radius: 10px;
                }
            }

    </style>

    @RenderSection("Styles", required: false)
    ```

</head>

<body class="d-flex flex-column min-vh-100">

    ```
    <!-- =====================================================
     HEADER
====================================================== -->

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark ps-navbar sticky-top">

            <div class="container-fluid ps-navbar-container">

                <!-- =================================================
                 BRAND
            ================================================== -->

