                <!-- =================================================
                 NAVIGATION
            ================================================== -->

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ps-nav">


                        <!-- =================================================
                         HOME
                    ================================================== -->
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">

                                <a class="nav-link ps-nav-link"
                                   asp-controller="Home"
                                   asp-action="Index">

                                    <i class="bi bi-grid-1x2"></i>

                                    <span>الرئيسية</span>

                                </a>

                            </li>
                        }


                        <!-- =================================================
                         ADMIN
                    ================================================== -->
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">

                                <a class="nav-link ps-nav-link"
                                   asp-controller="Users"
                                   asp-action="Index">

                                    <i class="bi bi-people-fill"></i>

                                    <span>المستخدمون</span>

                                </a>

                            </li>
