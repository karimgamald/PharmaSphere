@model IEnumerable<PharmaSphere.Web.ViewModels.UnitUnitsConfigViewModel>

@{
ViewData["Title"] = "إعدادات الوحدات";
}

<div class="container-fluid py-4" dir="rtl">

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <div class="text-primary fw-bold small mb-1">
            UNIT SELLING
        </div>

        <h2 class="fw-bold mb-1">
            إعدادات الوحدات
        </h2>

        <p class="text-muted mb-0">
            إدارة عدد الوحدات الموجودة داخل كل عبوة دواء.
        </p>
    </div>

    <a asp-controller="Medicine"
       asp-action="Index"
       class="btn btn-outline-secondary rounded-3">

        <i class="bi bi-arrow-right"></i>
        العودة للأدوية

    </a>

</div>


<div class="card border-0 shadow-sm rounded-4">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th class="px-4">
                            الدواء
                        </th>

                        <th>
                            المادة الفعالة
                        </th>

                        <th>
                            الباركود
                        </th>

                        <th>
                            الوحدات داخل العبوة
                        </th>

                        <th class="text-center">
                            الإجراء
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var medicine in Model)
                        {
                            <tr>

                                <td class="px-4">

                                    <div class="fw-bold">
                                        @medicine.Name
                                    </div>

                                </td>

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(medicine.ScientificName))
                                    {
                                        <span>
                                            @medicine.ScientificName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            غير محدد
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(medicine.Barcode))
                                    {
                                        <code>
                                            @medicine.Barcode
                                        </code>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>

                                <td>

                                    <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill">

                                        @medicine.UnitsPerBox

                                        وحدة / عبوة

                                    </span>

                                </td>

                                <td class="text-center">

                                    <a asp-controller="Medicine"
                                       asp-action="Edit"
                                       asp-route-id="@medicine.Id"
                                       class="btn btn-sm btn-outline-primary rounded-3">

                                        <i class="bi bi-pencil"></i>
                                        تعديل

                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="5"
                                class="text-center py-5">

                                <div class="text-muted">

                                    <i class="bi bi-box-seam fs-1 d-block mb-3"></i>

                                    لا توجد أدوية متاحة.

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
```

</div>
