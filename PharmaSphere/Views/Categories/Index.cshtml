@model IEnumerable<PharmaSphere.Domain.Entities.Category>

@{
    ViewData["Title"] = "أقسام الأدوية";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-tags me-2 text-primary"></i>تصنيفات الأدوية</h3>
        <p class="text-muted small mb-0">إدارة الفئات والأقسام الخاصة بالأدوية والمنتجات.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-3 px-4 shadow-sm fw-bold">
        <i class="bi bi-plus-lg me-1"></i> إضافة قسم جديد
    </a>
</div>

<div class="row g-3">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="fw-bold text-dark mb-0">@item.Name</h5>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light text-primary rounded-circle"><i class="bi bi-pencil"></i></a>
                    </div>
                    <p class="text-muted small mb-0">@(string.IsNullOrEmpty(item.Description) ? "لا يوجد وصف محدد لهذا القسم." : item.Description)</p>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5 text-muted">
            <i class="bi bi-folder-x fs-1 d-block mb-2"></i>
            لا توجد أقسام مسجلة حتى الآن.
        </div>
    }
</div>