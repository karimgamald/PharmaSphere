@using PharmaSphere.Domain.Entities
@model Category
@{
    ViewData["Title"] = "Edit Category";
}

<div class="container my-4" style="max-width: 600px;">
    <div class="card border-0 shadow-sm rounded-4 p-4">
        <h3 class="fw-bold text-dark mb-3"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Category</h3>
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold">Category Name</label>
                <input asp-for="Name" class="form-class form-control rounded-3" required />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold">Description</label>
                <textarea asp-for="Description" class="form-control rounded-3" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2 pt-2">
                <button type="submit" class="btn btn-primary fw-bold rounded-3 flex-fill">Save Changes</button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-3">Cancel</a>
            </div>
        </form>
    </div>
</div>