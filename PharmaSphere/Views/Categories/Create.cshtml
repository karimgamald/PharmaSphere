@model PharmaSphere.Domain.Entities.Category

@{
    ViewData["Title"] = "إضافة قسم جديد";
}

<div class="container py-3" style="max-width: 600px;">
    <div class="card border-0 shadow-sm rounded-4 p-4">
        <h4 class="fw-bold text-dark mb-4"><i class="bi bi-folder-plus text-primary me-2"></i>إضافة قسم جديد</h4>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold">اسم القسم <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control rounded-3" placeholder="مثال: المضادات الحيوية، مسكنات..." required />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label fw-semibold">الوصف</label>
                <textarea asp-for="Description" class="form-control rounded-3" rows="3" placeholder="وصف مختصر للقسم..."></textarea>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4 rounded-3 fw-bold"><i class="bi bi-check-lg me-1"></i> حفظ القسم</button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-3">إلغاء</a>
            </div>
        </form>
    </div>
</div>