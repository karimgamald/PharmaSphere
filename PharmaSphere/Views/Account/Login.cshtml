@model PharmaSphere.Web.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "تسجيل الدخول";
}

<div class="auth-page" dir="rtl">

    <div class="auth-card">

        <div class="text-center mb-4">

            <div class="auth-icon">
                <i class="bi bi-shield-lock"></i>
            </div>

            <h3 class="fw-bold mt-3 mb-1">
                تسجيل الدخول
            </h3>

            <p class="text-muted">
                قم بتسجيل الدخول إلى نظام PharmaSphere
            </p>

        </div>


        <form asp-action="Login" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="returnUrl"
                   value="@ViewData["ReturnUrl"]" />


            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger rounded-3">
            </div>


            <!-- Email -->

            <div class="mb-3">

                <label asp-for="Email"
                       class="form-label fw-semibold">
                    البريد الإلكتروني
                </label>

                <div class="input-group">

                    <span class="input-group-text">
                        <i class="bi bi-envelope"></i>
                    </span>

                    <input asp-for="Email"
                           class="form-control"
                           placeholder="example@email.com"
                           autocomplete="email" />

                </div>

                <span asp-validation-for="Email"
                      class="text-danger small">
                </span>

            </div>


            <!-- Password -->

            <div class="mb-3">

                <label asp-for="Password"
                       class="form-label fw-semibold">
                    كلمة المرور
                </label>

                <div class="input-group">

                    <span class="input-group-text">
                        <i class="bi bi-lock"></i>
                    </span>

                    <input asp-for="Password"
                           class="form-control"
                           placeholder="••••••••"
                           autocomplete="current-password" />

                </div>

                <span asp-validation-for="Password"
                      class="text-danger small">
                </span>

            </div>


            <!-- Remember -->

            <div class="form-check mb-4">

                <input asp-for="RememberMe"
                       class="form-check-input" />

                <label asp-for="RememberMe"
                       class="form-check-label">
                    تذكرني
                </label>

            </div>


            <button type="submit"
                    class="btn btn-primary w-100 py-2 rounded-3">

                <i class="bi bi-box-arrow-in-left me-1"></i>

                تسجيل الدخول

            </button>

        </form>


        <div class="text-center mt-4">

            <span class="text-muted">
                ليس لديك حساب؟
            </span>

            <a asp-action="Register"
               class="text-decoration-none fw-semibold">

                إنشاء حساب

            </a>

        </div>

    </div>

</div>


<style>

    .auth-page {
        min-height: 75vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px 15px;
    }

    .auth-card {
        width: 100%;
        max-width: 460px;
        background: #fff;
        border: 1px solid #edf0f2;
        border-radius: 24px;
        padding: 35px;
        box-shadow: 0 15px 40px rgba(0,0,0,.07);
    }

    .auth-icon {
        width: 70px;
        height: 70px;
        margin: auto;
        border-radius: 20px;
        background: rgba(13,110,253,.1);
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
    }

    .input-group-text {
        background: #f8f9fa;
        border-left: 0;
    }

    .input-group .form-control {
        border-right: 0;
    }

</style>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}