@model PharmaSphere.Web.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "إنشاء حساب";
}

<div class="auth-page" dir="rtl">

    <div class="auth-card register-card">

        <div class="text-center mb-4">

            <div class="auth-icon">
                <i class="bi bi-person-plus"></i>
            </div>

            <h3 class="fw-bold mt-3 mb-1">
                إنشاء حساب
            </h3>

            <p class="text-muted">
                إنشاء حساب عميل جديد في PharmaSphere
            </p>

        </div>


        <form asp-action="Register"
              method="post">

            @Html.AntiForgeryToken()


            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger rounded-3">
            </div>


            <!-- Full Name -->

            <div class="mb-3">

                <label asp-for="FullName"
                       class="form-label fw-semibold">
                    الاسم الكامل
                </label>

                <input asp-for="FullName"
                       class="form-control"
                       placeholder="أدخل الاسم الكامل"
                       autocomplete="name" />

                <span asp-validation-for="FullName"
                      class="text-danger small">
                </span>

            </div>


            <!-- Email -->

            <div class="mb-3">

                <label asp-for="Email"
                       class="form-label fw-semibold">
                    البريد الإلكتروني
                </label>

                <input asp-for="Email"
                       class="form-control"
                       placeholder="example@email.com"
                       autocomplete="email" />

                <span asp-validation-for="Email"
                      class="text-danger small">
                </span>

            </div>


            <!-- Phone -->

            <div class="mb-3">

                <label asp-for="PhoneNumber"
                       class="form-label fw-semibold">
                    رقم الهاتف
                </label>

                <input asp-for="PhoneNumber"
                       class="form-control"
                       placeholder="01xxxxxxxxx"
                       autocomplete="tel" />

                <span asp-validation-for="PhoneNumber"
                      class="text-danger small">
                </span>

            </div>


            <!-- Address -->

            <div class="mb-3">

                <label asp-for="Address"
                       class="form-label fw-semibold">
                    العنوان
                </label>

                <textarea asp-for="Address"
                          class="form-control"
                          rows="2"
                          placeholder="أدخل العنوان"></textarea>

                <span asp-validation-for="Address"
                      class="text-danger small">
                </span>

            </div>


            <!-- Password -->

            <div class="mb-3">

                <label asp-for="Password"
                       class="form-label fw-semibold">
                    كلمة المرور
                </label>

                <input asp-for="Password"
                       class="form-control"
                       placeholder="••••••••"
                       autocomplete="new-password" />

                <span asp-validation-for="Password"
                      class="text-danger small">
                </span>

            </div>


            <!-- Confirm Password -->

            <div class="mb-4">

                <label asp-for="ConfirmPassword"
                       class="form-label fw-semibold">
                    تأكيد كلمة المرور
                </label>

                <input asp-for="ConfirmPassword"
                       class="form-control"
                       placeholder="••••••••"
                       autocomplete="new-password" />

                <span asp-validation-for="ConfirmPassword"
                      class="text-danger small">
                </span>

            </div>


            <button type="submit"
                    class="btn btn-primary w-100 py-2 rounded-3">

                <i class="bi bi-person-plus me-1"></i>

                إنشاء الحساب

            </button>

        </form>


        <div class="text-center mt-4">

            <span class="text-muted">
                لديك حساب بالفعل؟
            </span>

            <a asp-action="Login"
               class="text-decoration-none fw-semibold">

                تسجيل الدخول

            </a>

        </div>

    </div>

</div>


<style>

    .auth-page {
        min-height: 75vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px 15px;
    }

    .auth-card {
        width: 100%;
        max-width: 460px;
        background: #fff;
        border: 1px solid #edf0f2;
        border-radius: 24px;
        padding: 35px;
        box-shadow: 0 15px 40px rgba(0,0,0,.07);
    }

    .auth-icon {
        width: 70px;
        height: 70px;
        margin: auto;
        border-radius: 20px;
        background: rgba(13,110,253,.1);
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
    }

</style>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}