@model PharmaSphere.Web.ViewModels.BatchFormViewModel

@{
    ViewData["Title"] = "تعديل بيانات التشغيلة";
}

<div dir="rtl" class="container-fluid py-3">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="page-icon">
                <i class="bi bi-pencil-square"></i>
            </div>
            <div>
                <h3 class="fw-bold text-dark mb-0">تعديل التشغيلة #@Model.BatchNumber</h3>
                <p class="text-muted small mb-0 mt-1">
                    تحديث بيانات الكمية، الأسعار، وتاريخ انتهاء الصلاحية للدفعة.
                </p>
            </div>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4 py-2 fw-semibold">
            <i class="bi bi-arrow-right ms-1"></i>
            الرجوع للقائمة
        </a>
    </div>

    <!-- Main Form Card -->
    <div class="row justify-content-center">
        <div class="col-xl-9 col-lg-10">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white border-bottom border-light px-4 py-3">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-sliders ms-2 text-primary"></i>
                        بيانات التشغيلة
                    </h5>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

                        <div class="row g-3">
                            <!-- Medicine Selection -->
                            <div class="col-md-6">
                                <label asp-for="MedicineId" class="form-label fw-semibold">الدواء <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-capsule"></i></span>
                                    <select asp-for="MedicineId" asp-items="Model.Medicines" class="form-select border-start-0 ps-0">
                                        <option value="">-- اختر الدواء --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="MedicineId" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Batch Number -->
                            <div class="col-md-6">
                                <label asp-for="BatchNumber" class="form-label fw-semibold">رقم التشغيلة / الدفعة <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-hash"></i></span>
                                    <input asp-for="BatchNumber" class="form-class border-start-0 form-control" placeholder="أدخل رقم التشغيلة" />
                                </div>
                                <span asp-validation-for="BatchNumber" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Expiry Date -->
                            <div class="col-md-6">
                                <label asp-for="ExpiryDate" class="form-label fw-semibold">تاريخ الانتهاء <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-calendar-event"></i></span>
                                    <input asp-for="ExpiryDate" type="date" class="form-control border-start-0" />
                                </div>
                                <span asp-validation-for="ExpiryDate" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Quantity -->
                            <div class="col-md-6">
                                <label asp-for="Quantity" class="form-label fw-semibold">الكمية (عدد الوحدات) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-boxes"></i></span>
                                    <input asp-for="Quantity" class="form-control border-start-0" placeholder="0" />
                                </div>
                                <span asp-validation-for="Quantity" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Purchase Price -->
                            <div class="col-md-6">
                                <label asp-for="PurchasePrice" class="form-label fw-semibold">سعر الشراء للوحدة <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-currency-dollar"></i></span>
                                    <input asp-for="PurchasePrice" class="form-control border-start-0" step="0.01" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="PurchasePrice" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Selling Price -->
                            <div class="col-md-6">
                                <label asp-for="SellingPrice" class="form-label fw-semibold">سعر البيع للوحدة <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-tag"></i></span>
                                    <input asp-for="SellingPrice" class="form-control border-start-0" step="0.01" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="SellingPrice" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light rounded-3 px-4 fw-semibold">إلغاء</a>
                            <button type="submit" class="btn btn-primary rounded-3 px-4 py-2 fw-bold shadow-sm">
                                <i class="bi bi-check-lg ms-1"></i>
                                حفظ التغييرات
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .page-icon {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(13, 110, 253, 0.1);
            color: #0d6efd;
            font-size: 1.4rem;
        }

        .input-group-text {
            border-radius: 0 8px 8px 0 !important;
        }

        .form-control, .form-select {
            border-radius: 8px 0 0 8px !important;
            padding: 10px 12px;
        }

            .form-control:focus, .form-select:focus {
                box-shadow: none;
                border-color: #86b7fe;
            }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}