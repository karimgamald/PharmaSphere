@using PharmaSphere.Domain.Enums
@model PharmaSphere.Domain.Entities.Prescription

@{
    ViewData["Title"] = "تفاصيل الروشتة #" + Model.Id;
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-dark mb-0"><i class="bi bi-file-medical me-2 text-primary"></i>تفاصيل الروشتة #@Model.Id</h3>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-3">العودة للقائمة</a>
    </div>

    <div class="row g-4">
        <!-- صورة الروشتة -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 text-center bg-light">
                <a href="@Model.ImagePath" target="_blank" title="اضغط للتكبير">
                    <img src="@Model.ImagePath" class="img-fluid rounded-3 shadow-sm" style="max-height: 500px; object-fit: contain;" alt="صورة الروشتة" />
                </a>
                <p class="text-muted small mt-2 mb-0"><i class="bi bi-zoom-in me-1"></i> اضغط على الصورة لفتحها بحجم كامل</p>
            </div>
        </div>

        <!-- تفاصيل ومعالجة الروشتة -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold text-dark mb-3">بيانات الطلب</h5>
                <hr />

                <div class="mb-3">
                    <span class="text-muted d-block small">اسم العميل:</span>
                    <strong class="text-dark">@(Model.Client?.UserName ?? Model.ClientId)</strong>
                </div>

                <div class="mb-3">
                    <span class="text-muted d-block small">تاريخ الرفع:</span>
                    <span>@Model.UploadedAt.ToLocalTime().ToString("f")</span>
                </div>

                <div class="mb-3">
                    <span class="text-muted d-block small">الطلب المرتبط:</span>
                    @if (Model.OrderId.HasValue)
                    {
                        <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId" class="badge bg-primary-subtle text-primary border text-decoration-none fs-6">
                            طلب رقم #@Model.OrderId
                        </a>
                    }
                    else
                    {
                        <span class="text-muted fst-italic">غير مرتبط بطلب حتى الآن</span>
                    }
                </div>
            </div>

            <!-- نموذج تحديث الحالة والملاحظات للصيدلي -->
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-person-badge text-primary me-2"></i>معالجة الصيدلي</h5>

                <form asp-action="UpdateStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">حالة الروشتة</label>
                        <select name="status" class="form-select rounded-3" asp-items="Html.GetEnumSelectList<PrescriptionStatus>()" asp-for="Status">
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">ملاحظات الصيدلي للعميل</label>
                        <textarea name="pharmacistNotes" class="form-control rounded-3" rows="3" placeholder="أدخل الأدوية المحددة أو سبب الرفض إن وجد...">@Model.PharmacistNotes</textarea>
                    </div>

                    <button type="submit" class="btn btn-success rounded-3 w-100 fw-bold">
                        <i class="bi bi-check2-circle me-1"></i> تحديث الحالة والملاحظات
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>