@model IEnumerable<PharmaSphere.Web.ViewModels.UserListViewModel>

@{
    ViewData["Title"] = "إدارة المستخدمين";
}

<div class="container-fluid py-4" dir="rtl">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-people-fill text-primary"></i>
                إدارة المستخدمين
            </h2>

            <p class="text-muted mb-0">
                إدارة حسابات المستخدمين والأدوار والصلاحيات
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary rounded-3 px-4">

            <i class="bi bi-person-plus-fill"></i>
            إضافة مستخدم
        </a>

    </div>


    <!-- Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }


    <!-- Users Table -->

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="px-4">
                                المستخدم
                            </th>

                            <th>
                                البريد الإلكتروني
                            </th>

                            <th>
                                الهاتف
                            </th>

                            <th>
                                الدور
                            </th>

                            <th>
                                تاريخ الإنشاء
                            </th>

                            <th>
                                الحالة
                            </th>

                            <th class="text-center">
                                الإجراءات
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var user in Model)
                        {
                            <tr>

                                <!-- User -->

                                <td class="px-4">

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="rounded-circle
                                            bg-primary
                                            bg-opacity-10
                                            text-primary
                                            d-flex
                                            align-items-center
                                            justify-content-center"
                                             style="width:45px;height:45px">

                                            <i class="bi bi-person-fill fs-5"></i>

                                        </div>

                                        <div>

                                            <div class="fw-bold">
                                                @user.FullName
                                            </div>

                                            <small class="text-muted">
                                                ID: @user.Id.Substring(0, Math.Min(8, user.Id.Length))
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <!-- Email -->

                                <td>
                                    @user.Email
                                </td>


                                <!-- Phone -->

                                <td>
                                    @(string.IsNullOrWhiteSpace(user.PhoneNumber)
                                        ? "-"
                                        : user.PhoneNumber)
                                </td>


                                <!-- Role -->

                                <td>

                                    @switch (user.Role)
                                    {
                                        case "Admin":
                                            <span class="badge bg-danger rounded-pill">
                                                Admin
                                            </span>
                                            break;

                                        case "Pharmacist":
                                            <span class="badge bg-primary rounded-pill">
                                                Pharmacist
                                            </span>
                                            break;

                                        case "DeliveryBoy":
                                            <span class="badge bg-warning text-dark rounded-pill">
                                                Delivery Boy
                                            </span>
                                            break;

                                        default:
                                            <span class="badge bg-secondary rounded-pill">
                                                Client
                                            </span>
                                            break;
                                    }

                                </td>


                                <!-- Created -->

                                <td>
                                    @user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                </td>


                                <!-- Email -->

                                <td>

                                    @if (user.EmailConfirmed)
                                    {
                                        <span class="text-success">
                                            <i class="bi bi-check-circle-fill"></i>
                                            مؤكد
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-warning">
                                            <i class="bi bi-clock-fill"></i>
                                            غير مؤكد
                                        </span>
                                    }

                                </td>


                                <!-- Actions -->

                                <td class="text-center">

                                    <div class="d-flex
                                        justify-content-center
                                        gap-2">

                                        <a asp-action="Edit"
                                           asp-route-id="@user.Id"
                                           class="btn btn-sm btn-outline-primary rounded-3"
                                           title="تعديل">

                                            <i class="bi bi-pencil-fill"></i>

                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@user.Id"
                                           class="btn btn-sm btn-outline-danger rounded-3"
                                           title="حذف">

                                            <i class="bi bi-trash-fill"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>