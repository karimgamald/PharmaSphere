@model PharmaSphere.Web.ViewModels.CreateUserViewModel

@{
    ViewData["Title"] = "إضافة مستخدم";
}

<div class="container py-4" dir="rtl">

    <div class="mb-4">

        <a asp-action="Index"
           class="text-decoration-none">

            <i class="bi bi-arrow-right"></i>
            العودة للمستخدمين

        </a>

        <h2 class="fw-bold mt-3">
            <i class="bi bi-person-plus-fill text-primary"></i>
            إضافة مستخدم جديد
        </h2>

        <p class="text-muted">
            يقوم Admin بإنشاء الحساب وتحديد الدور المناسب للمستخدم.
        </p>

    </div>


    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4">

            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>


                <div class="row g-4">

                    <!-- Full Name -->

                    <div class="col-md-6">

                        <label asp-for="FullName"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="FullName"
                               class="form-control form-control-lg rounded-3"
                               placeholder="مثال: أحمد محمد" />

                        <span asp-validation-for="FullName"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Email -->

                    <div class="col-md-6">

                        <label asp-for="Email"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Email"
                               class="form-control form-control-lg rounded-3"
                               placeholder="user@example.com" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Phone -->

                    <div class="col-md-6">

                        <label asp-for="PhoneNumber"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="PhoneNumber"
                               class="form-control form-control-lg rounded-3"
                               placeholder="01xxxxxxxxx" />

                        <span asp-validation-for="PhoneNumber"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Role -->

                    <div class="col-md-6">

                        <label asp-for="Role"
                               class="form-label fw-semibold">
                        </label>

                        <select asp-for="Role"
                                class="form-select form-select-lg rounded-3">

                            <option value="@PharmaSphere.Domain.Enums.UserRole.Client">
                                عميل - Client
                            </option>

                            <option value="@PharmaSphere.Domain.Enums.UserRole.Pharmacist">
                                صيدلي - Pharmacist
                            </option>

                            <option value="@PharmaSphere.Domain.Enums.UserRole.Delivery">
                                مندوب توصيل - DeliveryBoy
                            </option>

                            <option value="@PharmaSphere.Domain.Enums.UserRole.Admin">
                                مدير النظام - Admin
                            </option>

                        </select>

                        <span asp-validation-for="Role"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Address -->

                    <div class="col-12">

                        <label asp-for="Address"
                               class="form-label fw-semibold">
                        </label>

                        <textarea asp-for="Address"
                                  class="form-control rounded-3"
                                  rows="3"
                                  placeholder="العنوان"></textarea>

                        <span asp-validation-for="Address"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Password -->

                    <div class="col-md-6">

                        <label asp-for="Password"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Password"
                               class="form-control form-control-lg rounded-3"
                               autocomplete="new-password" />

                        <span asp-validation-for="Password"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Confirm Password -->

                    <div class="col-md-6">

                        <label asp-for="ConfirmPassword"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="ConfirmPassword"
                               class="form-control form-control-lg rounded-3"
                               autocomplete="new-password" />

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <hr class="my-4" />


                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-light rounded-3 px-4">

                        إلغاء

                    </a>

                    <button type="submit"
                            class="btn btn-primary rounded-3 px-4">

                        <i class="bi bi-person-plus-fill"></i>
                        إنشاء الحساب

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}