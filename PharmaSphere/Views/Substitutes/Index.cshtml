```cshtml
@model PharmaSphere.Web.ViewModels.SubstituteSearchViewModel

@using PharmaSphere.Domain.Entities

@{
    ViewData["Title"] = "البدائل الدوائية";

    var medicines =
        ViewBag.Medicines as List<Medicine>
        ?? new List<Medicine>();
}

<div class="substitutes-page" dir="rtl">

    <!-- =========================================================
         HEADER
    ========================================================== -->

    <div class="page-header">

        <div>

            <span class="page-eyebrow">
                PHARMACY MANAGEMENT
            </span>

            <h1>
                <i class="bi bi-arrow-left-right"></i>
                البدائل الدوائية
            </h1>

            <p>
                البحث عن الأدوية التي تحتوي على نفس المادة الفعالة
                والتركيز.
            </p>

        </div>

        <a asp-controller="Medicine"
           asp-action="Index"
           class="btn btn-light border">

            <i class="bi bi-capsule"></i>

            قائمة الأدوية

        </a>

    </div>


    <!-- =========================================================
         SEARCH
    ========================================================== -->

    <div class="search-card">

        <div class="search-title">

            <div class="search-icon">
                <i class="bi bi-search"></i>
            </div>

            <div>

                <h2>البحث عن البدائل</h2>

                <p>
                    اختر الدواء لعرض البدائل المتاحة.
                </p>

            </div>

        </div>


        <form asp-action="Index"
              method="get">

            <div class="row g-3 align-items-end">

                <div class="col-md-9">

                    <label class="form-label">
                        اختر الدواء
                    </label>

                    <select name="medicineId"
                            class="form-select form-select-lg"
                            required>

                        <option value="">
                            -- اختر الدواء --
                        </option>

                        @foreach (var medicine in medicines)
                        {
                            if (Model.MedicineId == medicine.Id)
                            {
                                <option value="@medicine.Id"
                                        selected>

                                    @medicine.Name

                                    @if (!string.IsNullOrWhiteSpace(
                                        medicine.ActiveIngredient))
                                    {
                                        @: - @medicine.ActiveIngredient
                                    }

                                </option>
                            }
                            else
                            {
                                <option value="@medicine.Id">

                                    @medicine.Name

                                    @if (!string.IsNullOrWhiteSpace(
                                        medicine.ActiveIngredient))
                                    {
                                        @: - @medicine.ActiveIngredient
                                    }

                                </option>
                            }
                        }

                    </select>

                </div>


                <div class="col-md-3">

                    <button type="submit"
                            class="btn btn-primary btn-lg w-100">

                        <i class="bi bi-search"></i>

                        البحث عن البدائل

                    </button>

                </div>

            </div>

        </form>

    </div>


    <!-- =========================================================
         ALERTS
    ========================================================== -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mt-4">

            <i class="bi bi-exclamation-triangle"></i>

            @TempData["Error"]

        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning mt-4">

            <i class="bi bi-exclamation-circle"></i>

            @TempData["Warning"]

        </div>
    }


    <!-- =========================================================
         SELECTED MEDICINE
    ========================================================== -->
    @if (Model.MedicineId > 0 &&
             !string.IsNullOrWhiteSpace(Model.MedicineName))
    {
        <div class="selected-medicine">

            <div class="selected-icon">
                <i class="bi bi-capsule-pill"></i>
            </div>

            <div class="selected-info">

                <span>
                    الدواء المطلوب إيجاد بدائل له
                </span>

                <h2>
                    @Model.MedicineName
                </h2>

                <div class="medicine-meta">

                    @if (!string.IsNullOrWhiteSpace(
                        Model.ActiveIngredient))
                    {
                        <span>
                            <i class="bi bi-bezier2"></i>

                            المادة الفعالة:

                            <strong>
                                @Model.ActiveIngredient
                            </strong>
                        </span>
                    }

                    @if (!string.IsNullOrWhiteSpace(
                        Model.Concentration))
                    {
                        <span>
                            <i class="bi bi-droplet"></i>

                            التركيز:

                            <strong>
                                @Model.Concentration
                            </strong>
                        </span>
                    }

                </div>

            </div>

        </div>
    }


    <!-- =========================================================
         RESULTS
    ========================================================== -->
    @if (Model.MedicineId > 0)
    {
        <div class="results-header">

            <div>

                <span class="results-eyebrow">
                    SEARCH RESULTS
                </span>

                <h2>
                    البدائل الدوائية
                </h2>

            </div>

            <div class="results-count">

                <strong>
                    @Model.Substitutes.Count
                </strong>

                <span>
                    بديل
                </span>

            </div>

        </div>


        @if (!Model.Substitutes.Any())
        {
            <div class="empty-state">

                <div class="empty-icon">
                    <i class="bi bi-capsule"></i>
                </div>

                <h3>
                    لا توجد بدائل متاحة
                </h3>

                <p>
                    لم يتم العثور على أدوية أخرى تحتوي على
                    نفس المادة الفعالة والتركيز.
                </p>

            </div>
        }
        else
        {
            <div class="row g-4">

                @foreach (var item in Model.Substitutes)
                {
                    <div class="col-md-6 col-xl-4">

                        <div class="substitute-card">

                            <!-- Header -->

                            <div class="substitute-card-header">

                                <div class="medicine-icon">
                                    <i class="bi bi-capsule-pill"></i>
                                </div>

                                @if (item.IsAvailable)
                                {
                                    <span class="stock-badge available">

                                        <i class="bi bi-check-circle"></i>

                                        متاح

                                    </span>
                                }
                                else
                                {
                                    <span class="stock-badge unavailable">

                                        <i class="bi bi-x-circle"></i>

                                        غير متوفر

                                    </span>
                                }

                            </div>


                            <!-- Medicine -->

                            <h3>
                                @item.Name
                            </h3>

                            @if (!string.IsNullOrWhiteSpace(
                                item.ScientificName))
                            {
                                <div class="scientific-name">

                                    @item.ScientificName

                                </div>
                            }


                            <!-- Active Ingredient -->

                            <div class="ingredient-box">

                                <span>
                                    المادة الفعالة
                                </span>

                                <strong>
                                    @item.ActiveIngredient
                                </strong>

                                @if (!string.IsNullOrWhiteSpace(
                                    item.Concentration))
                                {
                                    <small>
                                        @item.Concentration
                                    </small>
                                }

                            </div>


                            <!-- Details -->

                            <div class="medicine-details">

                                <div>

                                    <span>
                                        المخزون
                                    </span>

                                    <strong>
                                        @item.TotalStock
                                        وحدة
                                    </strong>

                                </div>


                                <div>

                                    <span>
                                        السعر
                                    </span>

                                    <strong>

                                        @if (item.LowestSellingPrice.HasValue)
                                        {
                                            @item.LowestSellingPrice.Value.ToString("N2")
                                            @: ج.م
                                        }
                                        else
                                        {
                                            @: —
                                        }

                                    </strong>

                                </div>


                                <div>

                                    <span>
                                        أقرب انتهاء
                                    </span>

                                    <strong>

                                        @if (item.NearestExpiryDate.HasValue)
                                        {
                                            @item.NearestExpiryDate.Value.ToString("yyyy/MM/dd")
                                        }
                                        else
                                        {
                                            @: —
                                        }

                                    </strong>

                                </div>

                            </div>


                            <!-- Prescription -->
                            @if (item.RequiresPrescription)
                            {
                                <div class="prescription-warning">

                                    <i class="bi bi-file-earmark-medical"></i>

                                    يحتاج إلى وصفة طبية

                                </div>
                            }


                            <!-- Action -->

                            <div class="substitute-actions">

                                <a asp-controller="Medicine"
                                   asp-action="Details"
                                   asp-route-id="@item.MedicineId"
                                   class="btn btn-outline-primary">

                                    <i class="bi bi-eye"></i>

                                    تفاصيل الدواء

                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
    }

</div>


<style>

    .substitutes-page {
        max-width: 1500px;
        margin: auto;
        padding: 1.5rem 0;
    }

    /* =========================================================
       HEADER
    ========================================================== */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .page-eyebrow,
    .results-eyebrow {
        display: block;
        color: #0d6efd;
        font-size: .65rem;
        font-weight: 900;
        letter-spacing: 1.5px;
    }

    .page-header h1 {
        margin: .3rem 0;
        font-size: 1.8rem;
        font-weight: 900;
    }

    .page-header h1 i {
        color: #0d6efd;
        margin-left: .4rem;
    }

    .page-header p {
        margin: 0;
        color: #7c8797;
        font-size: .82rem;
    }

    /* =========================================================
       SEARCH CARD
    ========================================================== */

    .search-card {
        padding: 1.5rem;
        border: 1px solid #e5eaf1;
        border-radius: 20px;
        background: white;
        box-shadow: 0 10px 30px rgba(15,23,42,.04);
    }

    .search-title {
        display: flex;
        align-items: center;
        gap: .85rem;
        margin-bottom: 1.4rem;
    }

    .search-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: #eaf2ff;
        color: #0d6efd;
        font-size: 1.2rem;
    }

    .search-title h2 {
        margin: 0;
        font-size: 1rem;
        font-weight: 900;
    }

    .search-title p {
        margin: .2rem 0 0;
        color: #8993a3;
        font-size: .72rem;
    }

    .form-label {
        margin-bottom: .45rem;
        font-size: .75rem;
        font-weight: 800;
    }

    .form-select {
        border-radius: 12px;
        border-color: #dfe5ed;
        font-size: .8rem;
    }

    /* =========================================================
       SELECTED MEDICINE
    ========================================================== */

    .selected-medicine {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 1.5rem;
        padding: 1.3rem;
        border: 1px solid #cfe2ff;
        border-radius: 18px;
        background: linear-gradient(
            135deg,
            #f0f6ff,
            #ffffff
        );
    }

    .selected-icon {
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        background: #0d6efd;
        color: white;
        font-size: 1.4rem;
    }

    .selected-info > span {
        color: #8993a3;
        font-size: .65rem;
        font-weight: 700;
    }

    .selected-info h2 {
        margin: .15rem 0 .45rem;
        font-size: 1.1rem;
        font-weight: 900;
    }

    .medicine-meta {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
        color: #667085;
        font-size: .72rem;
    }

    .medicine-meta strong {
        color: #1e293b;
    }

    /* =========================================================
       RESULTS HEADER
    ========================================================== */

    .results-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 2.2rem 0 1rem;
    }

    .results-header h2 {
        margin: .25rem 0 0;
        font-size: 1.25rem;
        font-weight: 900;
    }

    .results-count {
        display: flex;
        align-items: baseline;
        gap: .35rem;
        padding: .55rem .85rem;
        border: 1px solid #e5eaf1;
        border-radius: 12px;
        background: white;
    }

    .results-count strong {
        color: #0d6efd;
        font-size: 1.1rem;
    }

    .results-count span {
        color: #8b95a5;
        font-size: .7rem;
    }

    /* =========================================================
       SUBSTITUTE CARD
    ========================================================== */

    .substitute-card {
        height: 100%;
        padding: 1.35rem;
        border: 1px solid #e5eaf1;
        border-radius: 20px;
        background: white;
        transition: .25s ease;
    }

    .substitute-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 38px rgba(15,23,42,.08);
        border-color: #d4deea;
    }

    .substitute-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .medicine-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: #eaf2ff;
        color: #0d6efd;
        font-size: 1.25rem;
    }

    .stock-badge {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .35rem .6rem;
        border-radius: 50px;
        font-size: .62rem;
        font-weight: 800;
    }

    .stock-badge.available {
        color: #198754;
        background: #e8f7f0;
    }

    .stock-badge.unavailable {
        color: #dc3545;
        background: #fff0f1;
    }

    .substitute-card h3 {
        margin: 0 0 .25rem;
        font-size: 1rem;
        font-weight: 900;
    }

    .scientific-name {
        color: #8993a3;
        font-size: .7rem;
        margin-bottom: 1rem;
    }

    .ingredient-box {
        display: flex;
        flex-direction: column;
        gap: .15rem;
        padding: .8rem;
        margin-bottom: 1rem;
        border-radius: 12px;
        background: #f7f9fc;
    }

    .ingredient-box span {
        color: #8993a3;
        font-size: .62rem;
    }

    .ingredient-box strong {
        color: #334155;
        font-size: .78rem;
    }

    .ingredient-box small {
        color: #0d6efd;
        font-size: .65rem;
        font-weight: 700;
    }

    /* =========================================================
       DETAILS
    ========================================================== */

    .medicine-details {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: .5rem;
        margin-bottom: .9rem;
    }

    .medicine-details > div {
        padding: .65rem;
        border: 1px solid #edf0f4;
        border-radius: 10px;
        background: #fafbfc;
    }

    .medicine-details span {
        display: block;
        color: #929baa;
        font-size: .58rem;
        margin-bottom: .2rem;
    }

    .medicine-details strong {
        display: block;
        color: #273449;
        font-size: .7rem;
    }

    /* =========================================================
       PRESCRIPTION
    ========================================================== */

    .prescription-warning {
        display: flex;
        align-items: center;
        gap: .4rem;
        padding: .55rem .7rem;
        margin-bottom: .9rem;
        border-radius: 9px;
        background: #fff5df;
        color: #9a6700;
        font-size: .65rem;
        font-weight: 800;
    }

    /* =========================================================
       ACTION
    ========================================================== */

    .substitute-actions {
        margin-top: auto;
    }

    .substitute-actions .btn {
        width: 100%;
        border-radius: 10px;
        font-size: .72rem;
        font-weight: 800;
    }

    /* =========================================================
       EMPTY
    ========================================================== */

    .empty-state {
        padding: 4rem 1rem;
        margin-top: 1rem;
        text-align: center;
        border: 1px dashed #d7dee8;
        border-radius: 20px;
        background: white;
    }

    .empty-icon {
        width: 65px;
        height: 65px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto;
        border-radius: 18px;
        background: #f0f3f7;
        color: #8b95a5;
        font-size: 1.5rem;
    }

    .empty-state h3 {
        margin: 1rem 0 .4rem;
        font-size: 1rem;
        font-weight: 900;
    }

    .empty-state p {
        margin: 0;
        color: #8993a3;
        font-size: .75rem;
    }

    /* =========================================================
       RESPONSIVE
    ========================================================== */

    @@media (max-width: 767px) {

        .substitutes-page {
            padding: 1rem 0;
        }

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .selected-medicine {
            align-items: flex-start;
        }

        .medicine-meta {
            flex-direction: column;
            gap: .35rem;
        }

        .medicine-details {
            grid-template-columns: 1fr;
        }
    }

</style>
```
