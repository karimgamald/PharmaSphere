@* @model PharmaSphere.Web.ViewModels.ProfitReportViewModel

@{
    ViewData["Title"] = "تقرير صافي الأرباح والهوامش المالية";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-graph-up-arrow text-info me-2"></i>تحليلات الأرباح والمبيعات</h3>
        <p class="text-muted small mb-0">حساب الأرباح الفعلية بدقة بناءً على أسعار الشراء للـ Batches المستهلكة (FEFO).</p>
    </div>
</div>

<!-- Key Performance Indicators -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-primary text-white">
            <span class="small opacity-75 d-block mb-1">إجمالي الإيرادات</span>
            <h3 class="fw-bold my-1">@Model.TotalSalesRevenue.ToString("C2")</h3>
            <span class="small"><i class="bi bi-arrow-up-circle me-1"></i> المبيعات الكلية</span>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-dark text-white">
            <span class="small opacity-75 d-block mb-1">تكلفة المبيعات (COGS)</span>
            <h3 class="fw-bold my-1">@Model.TotalCostOfGoodsSold.ToString("C2")</h3>
            <span class="small text-muted"><i class="bi bi-truck me-1"></i> تكلفة الشراء</span>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-success text-white">
            <span class="small opacity-75 d-block mb-1">إجمالي الأرباح</span>
            <h3 class="fw-bold my-1">@Model.GrossProfit.ToString("C2")</h3>
            <span class="small"><i class="bi bi-cash-stack me-1"></i> صافي الربح</span>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-info text-white">
            <span class="small opacity-75 d-block mb-1">نسبة هامش الربح</span>
            <h3 class="fw-bold my-1">@Model.ProfitMarginPercentage.ToString("F1")%</h3>
            <span class="small"><i class="bi bi-pie-chart me-1"></i> Profit Margin</span>
        </div>
    </div>
</div>

<!-- Detailed Sales Breakdown -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white py-3 border-0">
        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-list-check text-primary me-2"></i>تفاصيل المبيعات والأرباح لكل بند</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">رقم الطلب</th>
                        <th>التاريخ</th>
                        <th>الدواء</th>
                        <th>الكمية المباعة</th>
                        <th>سعر البيع</th>
                        <th>سعر التكلفة</th>
                        <th class="pe-4 text-end">الربح المحقق</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DetailedSales != null && Model.DetailedSales.Any())
                    {
                        @foreach (var item in Model.DetailedSales)
                        {
                            var netProfit = (item.QuantitySold * item.SellingPrice) - (item.QuantitySold * item.PurchasePrice);
                            <tr>
                                <td class="ps-4 fw-bold text-primary">#@item.OrderNumber</td>
                                <td>@item.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="fw-semibold">@item.MedicineName</td>
                                <td><span class="badge bg-light text-dark border">@item.QuantitySold</span></td>
                                <td>@item.SellingPrice.ToString("C2")</td>
                                <td>@item.PurchasePrice.ToString("C2")</td>
                                <td class="pe-4 text-end fw-bold text-success">
                                    @netProfit.ToString("C2")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                لا توجد مبيعات مسجلة في هذه الفترة.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div> *@