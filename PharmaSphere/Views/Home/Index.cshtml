@using Microsoft.AspNetCore.Identity
@using PharmaSphere.Domain.Entities

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "الرئيسية - PharmaSphere";

    var isAuthenticated = SignInManager.IsSignedIn(User);

    var isAdmin = User.IsInRole("Admin");
    var isPharmacist = User.IsInRole("Pharmacist");
    var isDeliveryBoy = User.IsInRole("DeliveryBoy");
    var isClient = User.IsInRole("Client");

    var currentUser = isAuthenticated
        ? await UserManager.GetUserAsync(User)
        : null;

    var displayName = currentUser?.FullName
        ?? User.Identity?.Name
        ?? "المستخدم";

    var roleName =
        isAdmin ? "مدير النظام" :
        isPharmacist ? "صيدلي" :
        isDeliveryBoy ? "مندوب توصيل" :
        isClient ? "عميل" :
        "مستخدم";
}

<div class="pharma-dashboard" dir="rtl">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="dashboard-hero">

        <div class="hero-pattern"></div>

        <div class="hero-content">

            <div class="hero-text">

                <div class="hero-status">

                    <span class="status-dot"></span>

                    <span>
                        النظام يعمل بشكل طبيعي
                    </span>

                </div>


                @if (isAuthenticated)
                {
                    <h1>
                        مرحبًا
                        <span>@displayName</span>
                    </h1>

                    <div class="role-badge">
                        <i class="bi bi-person-badge"></i>
                        @roleName
                    </div>
                }
                else
                {
                    <h1>
                        مرحبًا بك في
                        <span>PharmaSphere</span>
                    </h1>
                }


                <p>
                    منصة متكاملة لإدارة الصيدلية،
                    المبيعات، المخزون، التوريد، الطلبات،
                    الوصفات الطبية والتقارير من مكان واحد.
                </p>


                <!-- =================================================
                     HERO ACTIONS
                ================================================== -->

                <div class="hero-actions">

                    @if (isAdmin || isPharmacist)
                    {
                        <a asp-controller="Pos"
                           asp-action="Index"
                           class="hero-primary-btn">

                            <i class="bi bi-cash-register"></i>

                            فتح نقطة البيع

                        </a>

                        <a asp-controller="Orders"
                           asp-action="Index"
                           class="hero-secondary-btn">

                            <i class="bi bi-receipt"></i>

                            إدارة الطلبات

                        </a>
                    }
                    else if (isDeliveryBoy)
                    {
                        <a asp-controller="Delivery"
                           asp-action="Index"
                           class="hero-primary-btn">

                            <i class="bi bi-truck"></i>

                            طلبات التوصيل

                        </a>

                        <a asp-controller="Orders"
                           asp-action="Index"
                           class="hero-secondary-btn">

                            <i class="bi bi-receipt"></i>

                            الطلبات

                        </a>
                    }
                    else if (isClient)
                    {
                        <a asp-controller="Shop"
                           asp-action="Index"
                           class="hero-primary-btn">

                            <i class="bi bi-shop"></i>

                            دخول المتجر

                        </a>

                        <a asp-controller="Orders"
                           asp-action="Index"
                           class="hero-secondary-btn">

                            <i class="bi bi-receipt"></i>

                            طلباتي

                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account"
                           asp-action="Login"
                           class="hero-primary-btn">

                            <i class="bi bi-box-arrow-in-left"></i>

                            تسجيل الدخول

                        </a>

                        <a asp-controller="Account"
                           asp-action="Register"
                           class="hero-secondary-btn">

                            <i class="bi bi-person-plus"></i>

                            إنشاء حساب

                        </a>
                    }

                </div>

            </div>


            <!-- =====================================================
                 HERO VISUAL
            ====================================================== -->

            <div class="hero-visual">

                <div class="hero-circle circle-one"></div>
                <div class="hero-circle circle-two"></div>

                <div class="hero-medical-icon">

                    <i class="bi bi-heart-pulse"></i>

                </div>


                <div class="floating-card floating-card-one">

                    <i class="bi bi-shield-check"></i>

                    <div>

                        <strong>
                            نظام آمن
                        </strong>

                        <span>
                            Protected
                        </span>

                    </div>

                </div>


                <div class="floating-card floating-card-two">

                    <i class="bi bi-box-seam"></i>

                    <div>

                        <strong>
                            إدارة المخزون
                        </strong>

                        <span>
                            Inventory
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         ADMIN / PHARMACIST QUICK ACCESS
    ====================================================== -->

    @if (isAdmin || isPharmacist)
    {
        <section class="dashboard-section">

            <div class="section-header">

                <span class="section-eyebrow">
                    QUICK ACCESS
                </span>

                <h2>
                    الوصول السريع
                </h2>

                <p>
                    أهم العمليات اليومية داخل الصيدلية.
                </p>

            </div>


            <div class="row g-3">

                <!-- POS -->

                <div class="col-12 col-sm-6 col-xl">

                    <a asp-controller="Pos"
                       asp-action="Index"
                       class="quick-card">

                        <div class="quick-icon blue">
                            <i class="bi bi-cash-register"></i>
                        </div>

                        <div class="quick-info">

                            <span>
                                المبيعات
                            </span>

                            <strong>
                                نقطة البيع POS
                            </strong>

                        </div>

                        <div class="quick-arrow">
                            <i class="bi bi-arrow-left"></i>
                        </div>

                    </a>

                </div>


                <!-- Orders -->

                <div class="col-12 col-sm-6 col-xl">

                    <a asp-controller="Orders"
                       asp-action="Index"
                       class="quick-card">

                        <div class="quick-icon teal">
                            <i class="bi bi-receipt-cutoff"></i>
                        </div>

                        <div class="quick-info">

                            <span>
                                الطلبات
                            </span>

                            <strong>
                                إدارة الطلبات
                            </strong>

                        </div>

                        <div class="quick-arrow">
                            <i class="bi bi-arrow-left"></i>
                        </div>

                    </a>

                </div>


                <!-- Medicines -->

                <div class="col-12 col-sm-6 col-xl">

                    <a asp-controller="Medicine"
                       asp-action="Index"
                       class="quick-card">

                        <div class="quick-icon red">
                            <i class="bi bi-capsule-pill"></i>
                        </div>

                        <div class="quick-info">

                            <span>
                                المخزون
                            </span>

                            <strong>
                                الأدوية والتشغيلات
                            </strong>

                        </div>

                        <div class="quick-arrow">
                            <i class="bi bi-arrow-left"></i>
                        </div>

                    </a>

                </div>


                <!-- Purchase -->

                <div class="col-12 col-sm-6 col-xl">

                    <a asp-controller="PurchaseOrders"
                       asp-action="Create"
                       class="quick-card">

                        <div class="quick-icon orange">
                            <i class="bi bi-truck"></i>
                        </div>

                        <div class="quick-info">

                            <span>
                                التوريد
                            </span>

                            <strong>
                                فاتورة شراء جديدة
                            </strong>

                        </div>

                        <div class="quick-arrow">
                            <i class="bi bi-arrow-left"></i>
                        </div>

                    </a>

                </div>


                <!-- Reports -->

                @if (isAdmin)
                {
                    <div class="col-12 col-sm-6 col-xl">

                        <a asp-controller="Reports"
                           asp-action="ProfitReport"
                           class="quick-card">

                            <div class="quick-icon green">
                                <i class="bi bi-graph-up-arrow"></i>
                            </div>

                            <div class="quick-info">

                                <span>
                                    التحليلات
                                </span>

                                <strong>
                                    التقارير المالية
                                </strong>

                            </div>

                            <div class="quick-arrow">
                                <i class="bi bi-arrow-left"></i>
                            </div>

                        </a>

                    </div>
                }

            </div>

        </section>
    }


    <!-- =====================================================
         CLIENT DASHBOARD
    ====================================================== -->

    @if (isClient)
    {
        <section class="dashboard-section">

            <div class="section-header">

                <span class="section-eyebrow">
                    CUSTOMER AREA
                </span>

                <h2>
                    خدماتي
                </h2>

                <p>
                    الوصول السريع إلى خدماتك وطلباتك.
                </p>

            </div>


            <div class="row g-4">

                <!-- Shop -->

                <div class="col-md-6 col-lg-4">

                    <a asp-controller="Shop"
                       asp-action="Index"
                       class="module-card client-module">

                        <div class="module-header">

                            <div class="module-icon blue">
                                <i class="bi bi-shop"></i>
                            </div>

                            <span class="module-tag blue">
                                STORE
                            </span>

                        </div>

                        <h3>
                            المتجر الإلكتروني
                        </h3>

                        <p>
                            تصفح الأدوية والمنتجات المتاحة
                            وأضف المنتجات إلى سلة الشراء.
                        </p>

                        <span class="module-link blue">

                            فتح المتجر

                            <i class="bi bi-arrow-left"></i>

                        </span>

                    </a>

                </div>


                <!-- Orders -->

                <div class="col-md-6 col-lg-4">

                    <a asp-controller="Orders"
                       asp-action="Index"
                       class="module-card client-module">

                        <div class="module-header">

                            <div class="module-icon teal">
                                <i class="bi bi-receipt"></i>
                            </div>

                            <span class="module-tag teal">
                                ORDERS
                            </span>

                        </div>

                        <h3>
                            طلباتي
                        </h3>

                        <p>
                            متابعة طلباتك السابقة وحالة
                            الطلب والدفع والتوصيل.
                        </p>

                        <span class="module-link teal">

                            عرض طلباتي

                            <i class="bi bi-arrow-left"></i>

                        </span>

                    </a>

                </div>


                <!-- Prescriptions -->

                <div class="col-md-6 col-lg-4">

                    <a asp-controller="Prescriptions"
                       asp-action="Index"
                       class="module-card client-module">

                        <div class="module-header">

                            <div class="module-icon purple">
                                <i class="bi bi-file-earmark-medical"></i>
                            </div>

                            <span class="module-tag purple">
                                MEDICAL
                            </span>

                        </div>

                        <h3>
                            الوصفات الطبية
                        </h3>

                        <p>
                            متابعة الوصفات الطبية الخاصة
                            بك وحالتها داخل الصيدلية.
                        </p>

                        <span class="module-link purple">

                            عرض الوصفات

                            <i class="bi bi-arrow-left"></i>

                        </span>

                    </a>

                </div>

            </div>

        </section>
    }


    <!-- =====================================================
         DELIVERY DASHBOARD
    ====================================================== -->

    @if (isDeliveryBoy)
    {
        <section class="dashboard-section">

            <div class="section-header">

                <span class="section-eyebrow">
                    DELIVERY OPERATIONS
                </span>

                <h2>
                    عمليات التوصيل
                </h2>

                <p>
                    متابعة الطلبات المسندة إليك وإدارة عمليات التوصيل.
                </p>

            </div>


            <div class="row g-4">

                <div class="col-md-6 col-lg-4">

                    <a asp-controller="Delivery"
                       asp-action="Index"
                       class="module-card">

                        <div class="module-header">

                            <div class="module-icon orange">
                                <i class="bi bi-truck"></i>
                            </div>

                            <span class="module-tag orange">
                                DELIVERY
                            </span>

                        </div>

                        <h3>
                            طلبات التوصيل
                        </h3>

                        <p>
                            عرض الطلبات المسندة إليك
                            ومتابعة حالة التوصيل.
                        </p>

                        <span class="module-link orange">

                            إدارة التوصيل

                            <i class="bi bi-arrow-left"></i>

                        </span>

                    </a>

                </div>


                <div class="col-md-6 col-lg-4">

                    <a asp-controller="Orders"
                       asp-action="Index"
                       class="module-card">

                        <div class="module-header">

                            <div class="module-icon teal">
                                <i class="bi bi-receipt"></i>
                            </div>

                            <span class="module-tag teal">
                                ORDERS
                            </span>

                        </div>

                        <h3>
                            الطلبات المسندة
                        </h3>

                        <p>
                            مراجعة تفاصيل الطلبات المرتبطة
                            بعمليات التوصيل.
                        </p>

                        <span class="module-link teal">

                            عرض الطلبات

                            <i class="bi bi-arrow-left"></i>

                        </span>

                    </a>

                </div>

            </div>

        </section>
    }


    <!-- =====================================================
         ADMIN / PHARMACIST CORE MODULES
    ====================================================== -->

    @if (isAdmin || isPharmacist)
    {
        <section class="dashboard-section">

            <div class="section-header section-header-flex">

                <div>

                    <span class="section-eyebrow">
                        CORE MODULES
                    </span>

                    <h2>
                        إدارة الصيدلية
                    </h2>

                    <p>
                        الوحدات الأساسية للعمليات اليومية.
                    </p>

                </div>


                <div class="module-counter">

                    <strong>
                        @(isAdmin ? "12" : "9")
                    </strong>

                    <span>
                        وحدات
                    </span>

                </div>

            </div>


            <div class="row g-4">

                <!-- POS -->

                <div class="col-md-6 col-lg-3">

                    <div class="module-card">

                        <div class="module-header">

                            <div class="module-icon blue">
                                <i class="bi bi-display"></i>
                            </div>

                            <span class="module-tag blue">
                                المبيعات
                            </span>

                        </div>

                        <h3>
                            شاشة الكاشير
                        </h3>

                        <p>
                            تنفيذ عمليات البيع وإدارة الكميات
                            وتطبيق استراتيجية FEFO.
                        </p>

                        <a asp-controller="Pos"
                           asp-action="Index"
                           class="module-link blue">

                            فتح شاشة البيع

                            <i class="bi bi-arrow-left"></i>

                        </a>

                    </div>

                </div>


                <!-- Orders -->

                <div class="col-md-6 col-lg-3">

                    <div class="module-card">

                        <div class="module-header">

                            <div class="module-icon teal">
                                <i class="bi bi-receipt"></i>
                            </div>

                            <span class="module-tag teal">
                                الطلبات
                            </span>

                        </div>

                        <h3>
                            إدارة الطلبات
                        </h3>

                        <p>
                            متابعة الطلبات ومراجعة حالتها
                            وتفاصيل المنتجات والدفع.
                        </p>

                        <a asp-controller="Orders"
                           asp-action="Index"
                           class="module-link teal">

                            عرض الطلبات

                            <i class="bi bi-arrow-left"></i>

                        </a>

                    </div>

                </div>


                <!-- Medicines -->

                <div class="col-md-6 col-lg-3">

                    <div class="module-card">

                        <div class="module-header">

                            <div class="module-icon red">
                                <i class="bi bi-capsule"></i>
                            </div>

                            <span class="module-tag red">
                                المخزون
                            </span>

                        </div>

                        <h3>
                            إدارة الأدوية
                        </h3>

                        <p>
                            إدارة الأدوية والمواد الفعالة
                            والتشغيلات وتواريخ الصلاحية.
                        </p>

                        <a asp-controller="Medicine"
                           asp-action="Index"
                           class="module-link red">

                            إدارة الأدوية

                            <i class="bi bi-arrow-left"></i>

                        </a>

                    </div>

                </div>


                <!-- Categories -->

                <div class="col-md-6 col-lg-3">

                    <div class="module-card">

                        <div class="module-header">

                            <div class="module-icon purple">
                                <i class="bi bi-tags"></i>
                            </div>

                            <span class="module-tag purple">
                                التصنيفات
                            </span>

                        </div>

                        <h3>
                            التصنيفات الدوائية
                        </h3>

                        <p>
                            تنظيم الأدوية داخل تصنيفات واضحة
                            لتسهيل الإدارة والبحث.
                        </p>

                        <a asp-controller="Categories"
                           asp-action="Index"
                           class="module-link purple">

                            عرض التصنيفات

                            <i class="bi bi-arrow-left"></i>

                        </a>

                    </div>

                </div>


                <!-- Suppliers -->

                <div class="col-md-6 col-lg-3">

                    <div class="module-card">

                        <div class="module-header">

                            <div class="module-icon dark">
                                <i class="bi bi-building"></i>
                            </div>

                            <span class="module-tag dark">
                                الموردون
                            </span>

                        </div>

                        <h3>
                            إدارة الموردين
                        </h3>

                        <p>
                            إدارة بيانات الموردين وربطهم
                            بعمليات التوريد.
                        </p>

                        <a asp-controller="Suppliers"
                           asp-action="Index"
                           class="module-link dark">

                            قائمة الموردين

                            <i class="bi bi-arrow-left"></i>

                        </a>

                    </div>

                </div>


                <!-- Purchase -->

                <div class="col-md-6 col-lg-3">

                    <div class="module-card">

                        <div class="module-header">

                            <div class="module-icon orange">
                                <i class="bi bi-truck-front"></i>
                            </div>

                            <span class="module-tag orange">
                                التوريد
                            </span>

                        </div>

                        <h3>
                            فواتير التوريد
                        </h3>

                        <p>
                            تسجيل الشحنات والكميات وأسعار
                            الشراء وتواريخ الصلاحية.
                        </p>

                        <a asp-controller="PurchaseOrders"
                           asp-action="Create"
                           class="module-link orange">

                            تسجيل شحنة

                            <i class="bi bi-arrow-left"></i>

                        </a>

                    </div>

                </div>


                <!-- Prescriptions -->

                <div class="col-md-6 col-lg-3">

                    <div class="module-card">

                        <div class="module-header">

                            <div class="module-icon teal">
                                <i class="bi bi-file-earmark-medical"></i>
                            </div>

                            <span class="module-tag teal">
                                طبي
                            </span>

                        </div>

                        <h3>
                            إدارة الروشتات
                        </h3>

                        <p>
                            مراجعة الوصفات الطبية المرفوعة
                            ومتابعة حالتها.
                        </p>

                        <a asp-controller="Prescriptions"
                           asp-action="Index"
                           class="module-link teal">

                            استعراض الروشتات

                            <i class="bi bi-arrow-left"></i>

                        </a>

                    </div>

                </div>


                <!-- Reports Admin only -->

                @if (isAdmin)
                {
                    <div class="col-md-6 col-lg-3">

                        <div class="module-card">

                            <div class="module-header">

                                <div class="module-icon green">
                                    <i class="bi bi-bar-chart-line"></i>
                                </div>

                                <span class="module-tag green">
                                    التقارير
                                </span>

                            </div>

                            <h3>
                                التقارير المالية
                            </h3>

                            <p>
                                تحليل المبيعات والتكاليف والأرباح
                                اعتمادًا على تكلفة الـBatch.
                            </p>

                            <a asp-controller="Reports"
                               asp-action="ProfitReport"
                               class="module-link green">

                                عرض التقارير

                                <i class="bi bi-arrow-left"></i>

                            </a>

                        </div>

                    </div>
                }

            </div>

        </section>
    }


    <!-- =====================================================
         ADVANCED OPERATIONS
    ====================================================== -->

    @if (isAdmin || isPharmacist)
    {
        <section class="dashboard-section">

            <div class="section-header">

                <span class="section-eyebrow">
                    OPERATIONS & CONTROL
                </span>

                <h2>
                    العمليات المتقدمة
                </h2>

                <p>
                    أدوات التحكم في المخزون والمرتجعات
                    والمراجعة والعمليات الداخلية.
                </p>

            </div>


            <div class="row g-4">

                <!-- Batches -->

                <div class="col-md-6 col-lg-4">

                    <div class="advanced-card">

                        <div class="advanced-icon blue">
                            <i class="bi bi-calendar2-check"></i>
                        </div>

                        <div>

                            <span class="advanced-label">
                                FEFO
                            </span>

                            <h3>
                                إدارة التشغيلات
                            </h3>

                            <p>
                                متابعة كل Batch بشكل مستقل
                                وصرف الأقرب انتهاءً أولًا.
                            </p>

                            <a asp-controller="MedicineBatches"
                               asp-action="Index">

                                إدارة التشغيلات

                                <i class="bi bi-arrow-left"></i>

                            </a>

                        </div>

                    </div>

                </div>


                <!-- Substitutes -->

                <div class="col-md-6 col-lg-4">

                    <div class="advanced-card">

                        <div class="advanced-icon teal">
                            <i class="bi bi-search"></i>
                        </div>

                        <div>

                            <span class="advanced-label">
                                ACTIVE INGREDIENT
                            </span>

                            <h3>
                                البدائل الدوائية
                            </h3>

                            <p>
                                البحث عن الأدوية التي تحتوي
                                على نفس المادة الفعالة والتركيز.
                            </p>

                            <a asp-controller="Medicine"
                               asp-action="Substitutes">

                                البحث عن البدائل

                                <i class="bi bi-arrow-left"></i>

                            </a>

                        </div>

                    </div>

                </div>


                <!-- Stock -->

                <div class="col-md-6 col-lg-4">

                    <div class="advanced-card">

                        <div class="advanced-icon green">
                            <i class="bi bi-boxes"></i>
                        </div>

                        <div>

                            <span class="advanced-label">
                                STOCK CONTROL
                            </span>

                            <h3>
                                مراقبة المخزون
                            </h3>

                            <p>
                                متابعة حركة الكميات الناتجة
