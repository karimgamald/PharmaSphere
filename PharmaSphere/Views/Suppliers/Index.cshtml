@model IEnumerable<PharmaSphere.Domain.Entities.Supplier>

@{
    ViewData["Title"] = "إدارة الموردين";

    var suppliers = Model?.ToList()
        ?? new List<PharmaSphere.Domain.Entities.Supplier>();

    var totalSuppliers = suppliers.Count;
    var activeSuppliers = suppliers.Count(s => s.IsActive);
    var inactiveSuppliers = suppliers.Count(s => !s.IsActive);
}

<div class="container-fluid py-3" dir="rtl">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-truck text-primary me-2"></i>
                إدارة الموردين
            </h3>

            <p class="text-muted small mb-0">
                إدارة شبكة توريد الأدوية والمستلزمات الطبية.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary rounded-3 px-4 shadow-sm fw-bold">
            <i class="bi bi-plus-lg me-1"></i>
            إضافة مورد جديد
        </a>

    </div>


    <!-- Statistics -->
    <div class="row g-3 mb-4">

        <!-- Total -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center gap-3">

                    <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                        <i class="bi bi-buildings fs-4"></i>
                    </div>

                    <div>
                        <div class="text-muted small">
                            إجمالي الموردين
                        </div>

                        <div class="fs-4 fw-bold text-dark">
                            @totalSuppliers
                        </div>
                    </div>

                </div>
            </div>
        </div>


        <!-- Active -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center gap-3">

                    <div class="bg-success bg-opacity-10 text-success rounded-3 p-3">
                        <i class="bi bi-check-circle fs-4"></i>
                    </div>

                    <div>
                        <div class="text-muted small">
                            الموردون النشطون
                        </div>

                        <div class="fs-4 fw-bold text-success">
                            @activeSuppliers
                        </div>
                    </div>

                </div>
            </div>
        </div>


        <!-- Inactive -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center gap-3">

                    <div class="bg-secondary bg-opacity-10 text-secondary rounded-3 p-3">
                        <i class="bi bi-pause-circle fs-4"></i>
                    </div>

                    <div>
                        <div class="text-muted small">
                            الموردون غير النشطين
                        </div>

                        <div class="fs-4 fw-bold text-secondary">
                            @inactiveSuppliers
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>


    <!-- Suppliers Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="fw-bold mb-1">
                        قائمة الموردين
                    </h5>

                    <span class="text-muted small">
                        بيانات الموردين المسجلين في النظام
                    </span>
                </div>

                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
                    @totalSuppliers مورد
                </span>

            </div>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-4">
                                #
                            </th>

                            <th>
                                المورد / الشركة
                            </th>

                            <th>
                                الهاتف
                            </th>

                            <th>
                                البريد الإلكتروني
                            </th>

                            <th>
                                العنوان
                            </th>

                            <th>
                                الحالة
                            </th>

                            <th class="pe-4 text-end">
                                الإجراءات
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (suppliers.Any())
                        {
                            foreach (var item in suppliers)
                            {
                                <tr class="@(!item.IsActive ? "table-secondary" : "")">

                                    <!-- ID -->
                                    <td class="ps-4 text-muted">
                                        #@item.Id
                                    </td>


                                    <!-- Supplier -->
                                    <td>

                                        <div class="d-flex align-items-center gap-2">

                                            <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-2">
                                                <i class="bi bi-building"></i>
                                            </div>

                                            <div>
                                                <div class="fw-bold text-dark">
                                                    @item.Name
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(item.Address))
                                                {
                                                    <div class="text-muted small">
                                                        <i class="bi bi-geo-alt me-1"></i>
                                                        @item.Address
                                                    </div>
                                                }
                                            </div>

                                        </div>

                                    </td>


                                    <!-- Phone -->
                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(item.Phone))
                                        {
                                            <span class="text-dark">
                                                <i class="bi bi-telephone text-muted me-1"></i>
                                                @item.Phone
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                غير مسجل
                                            </span>
                                        }

                                    </td>


                                    <!-- Email -->
                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(item.Email))
                                        {
                                            <span class="text-dark">
                                                <i class="bi bi-envelope text-muted me-1"></i>
                                                @item.Email
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                غير مسجل
                                            </span>
                                        }

                                    </td>


                                    <!-- Address -->
                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(item.Address))
                                        {
                                            <span class="text-muted">
                                                @(item.Address.Length > 35
                                                    ? item.Address.Substring(0, 35) + "..."
                                                    : item.Address)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                غير مسجل
                                            </span>
                                        }

                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">
                                                <i class="bi bi-check-circle me-1"></i>
                                                نشط
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3">
                                                <i class="bi bi-pause-circle me-1"></i>
                                                غير نشط
                                            </span>
                                        }

                                    </td>


                                    <!-- Actions -->
                                    <td class="pe-4 text-end">

                                        <div class="btn-group btn-group-sm">

                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-outline-secondary"
                                               title="تعديل المورد">

                                                <i class="bi bi-pencil"></i>

                                            </a>


                                            <!-- Details -->
                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-outline-info"
                                               title="تفاصيل المورد">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            @if (item.IsActive)
                                            {
                                                <!-- Deactivate -->
                                                <form asp-action="Deactivate"
                                                      asp-route-id="@item.Id"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-outline-warning"
                                                            title="تعطيل المورد"
                                                            onclick="return confirm('هل أنت متأكد من تعطيل هذا المورد؟');">

                                                        <i class="bi bi-pause-circle"></i>

                                                    </button>

                                                </form>
                                            }
                                            else
                                            {
                                                <!-- Activate -->
                                                <form asp-action="Activate"
                                                      asp-route-id="@item.Id"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-outline-success"
                                                            title="تفعيل المورد"
                                                            onclick="return confirm('هل أنت متأكد من تفعيل هذا المورد؟');">

                                                        <i class="bi bi-play-circle"></i>

                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="bi bi-truck fs-1 d-block mb-3 opacity-50"></i>

                                        <h6 class="fw-bold">
                                            لا يوجد موردون
                                        </h6>

                                        <p class="small mb-3">
                                            لم يتم تسجيل أي موردين في النظام حتى الآن.
                                        </p>

                                        <a asp-action="Create"
                                           class="btn btn-primary btn-sm rounded-3">

                                            <i class="bi bi-plus-lg me-1"></i>
                                            إضافة أول مورد

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>