@model PharmaSphere.Domain.Entities.Supplier

@{
    ViewData["Title"] = "تعديل بيانات المورد";
}

<div class="container py-4" dir="rtl" style="max-width: 700px;">

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <!-- Header -->
        <div class="card-header bg-white border-0 p-4 pb-2">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                    <i class="bi bi-pencil-square fs-4"></i>
                </div>

                <div>
                    <h4 class="fw-bold text-dark mb-1">
                        تعديل بيانات المورد
                    </h4>

                    <p class="text-muted mb-0 small">
                        قم بتحديث بيانات المورد ثم احفظ التعديلات
                    </p>
                </div>
            </div>
        </div>

        <!-- Form -->
        <div class="card-body p-4">

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger rounded-3"
                     role="alert">
                </div>

                <!-- Supplier Name -->
                <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-semibold">
                        اسم المورد / الشركة
                        <span class="text-danger">*</span>
                    </label>

                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-building text-muted"></i>
                        </span>

                        <input asp-for="Name"
                               class="form-control border-start-0"
                               placeholder="أدخل اسم المورد..."
                               autocomplete="organization" />
                    </div>

                    <span asp-validation-for="Name"
                          class="text-danger small">
                    </span>
                </div>

                <!-- Phone -->
                <div class="mb-4">
                    <label asp-for="Phone" class="form-label fw-semibold">
                        رقم الهاتف
                    </label>

                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-telephone text-muted"></i>
                        </span>

                        <input asp-for="Phone"
                               type="tel"
                               class="form-control border-start-0"
                               placeholder="01XXXXXXXXX"
                               autocomplete="tel" />
                    </div>

                    <span asp-validation-for="Phone"
                          class="text-danger small">
                    </span>
                </div>

                <!-- Email -->
                <div class="mb-4">
                    <label asp-for="Email" class="form-label fw-semibold">
                        البريد الإلكتروني
                    </label>

                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-envelope text-muted"></i>
                        </span>

                        <input asp-for="Email"
                               type="email"
                               class="form-control border-start-0"
                               placeholder="supplier@example.com"
                               autocomplete="email" />
                    </div>

                    <span asp-validation-for="Email"
                          class="text-danger small">
                    </span>
                </div>

                <!-- Address -->
                <div class="mb-4">
                    <label asp-for="Address" class="form-label fw-semibold">
                        العنوان
                    </label>

                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 align-items-start pt-3">
                            <i class="bi bi-geo-alt text-muted"></i>
                        </span>

                        <textarea asp-for="Address"
                                  class="form-control border-start-0"
                                  rows="3"
                                  placeholder="أدخل عنوان المورد..."
                                  autocomplete="street-address"></textarea>
                    </div>

                    <span asp-validation-for="Address"
                          class="text-danger small">
                    </span>
                </div>

                <!-- Current Status -->
                <div class="alert @(Model.IsActive ? "alert-success" : "alert-warning") border-0 rounded-3 d-flex align-items-start gap-2 mb-4">

                    <i class="bi @(Model.IsActive ? "bi-check-circle-fill" : "bi-pause-circle-fill") mt-1"></i>

                    <div>
                        <div class="fw-semibold">
                            حالة المورد:
                            @(Model.IsActive ? "نشط" : "غير نشط")
                        </div>

                        <div class="small">
                            يتم تغيير حالة المورد من خلال أزرار
                            <strong>التفعيل / التعطيل</strong>
                            في صفحة الموردين.
                        </div>
                    </div>

                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-between align-items-center pt-2">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary px-4 rounded-3">
                        <i class="bi bi-arrow-right me-1"></i>
                        العودة
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4 rounded-3 fw-bold">
                        <i class="bi bi-check-lg me-1"></i>
                        حفظ التعديلات
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}